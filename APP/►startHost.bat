@echo off
:: Блокируем вывод лишних системных команд в консоль
setlocal

:: Включаем поддержку UTF-8, чтобы русский текст и символы (типа ►) отображались корректно
chcp 65001 >nul

:: Переходим строго в папку, где лежит этот батник (важно для портативности)
cd /d "%~dp0"

:: Задаем четкое и понятное имя для окна консоли
title WEB SERVER (Main Mode)

cls
echo ==================================================
echo          МГНОВЕННЫЙ ЗАПУСК СЕРВЕРА (ОСНОВНОЙ)     
echo ==================================================
echo.

:: Запускаем PowerShell в режиме максимальной изоляции:
:: -NoProfile      = игнорируем тяжелые профили пользователя (чистый запуск)
:: -NoLogo         = убираем мусорный текст копирайтов Microsoft при старте
:: -ExecutionPolicy Bypass = временно разрешаем запуск нашего .ps1 без изменения настроек Windows
powershell -NoProfile -NoLogo -ExecutionPolicy Bypass -File "server.ps1"

:: Ловушка на выходе: если сервер упадет или вы нажмете Ctrl+C, окно не захлопнется сразу,
:: и вы успеете прочитать логи или ошибки.
echo.
echo ==================================================
echo [INFO] Сессия завершена. Сервер остановлен.
echo ==================================================
pause